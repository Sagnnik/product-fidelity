# Create a key at https://fal.ai/dashboard/keys and save it in an untracked .env file.
FAL_API_KEY=
FAL_MAX_SPEND_USD=8.00

# Clerk backend keys. Never commit a real secret key.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# Optional persistent directory; Railway's volume mount path is used automatically when attached.
# STILLROOM_DATA_DIR=/absolute/path/to/data

# Optional direct publishing to Facebook Pages and linked professional Instagram accounts.
# Add a Meta app with the Facebook Login product and register the exact HTTPS callback URL.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Generate once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
META_TOKEN_ENCRYPTION_KEY=
SOCIAL_PUBLIC_BASE_URL=
META_GRAPH_VERSION=v26.0
